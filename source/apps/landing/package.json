{
  "name": "restorekit-landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build -c vite.prerender.config.ts && node scripts/prerender.js",
    "preview": "vite preview",
    "check": "wrangler types && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.worker.json",
    "cf-typegen": "wrangler types",
    "deploy": "pnpm build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1",
    "@sveltejs/vite-plugin-svelte": "^7",
    "@tailwindcss/vite": "^4",
    "@types/three": "^0.187.0",
    "drizzle-kit": "^0.31.11",
    "svelte": "^5",
    "svelte-check": "^4",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vite": "^8",
    "wrangler": "^4"
  },
  "dependencies": {
    "@threlte/core": "^8.7.0",
    "drizzle-orm": "^0.45.4",
    "shiki": "^4.6.0",
    "three": "^0.187.0"
  }
}
