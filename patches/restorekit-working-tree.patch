+#[cfg(target_os = "windows")]
+pub(crate) fn probe_usbmux_endpoint(port: u16) -> Result<()> {
+    use std::io::{Read, Write};
+    use std::net::{Ipv4Addr, SocketAddr, TcpStream};
+    use std::time::Duration;
+
+    let probe = || -> std::result::Result<(), String> {
+        if port != 27016 { return Err("only private loopback port27016 may be probed".into()); }
+        let address = SocketAddr::from((Ipv4Addr::LOCALHOST, port));
+        let timeout = Duration::from_secs(3);
+        let mut stream = TcpStream::connect_timeout(&address, timeout)
+            .map_err(|e| format!("cannot connect to {address}: {e}"))?;
+        stream.set_read_timeout(Some(timeout)).map_err(|e| e.to_string())?;
+        stream.set_write_timeout(Some(timeout)).map_err(|e| e.to_string())?;
+        // usbmux protocol v1, plist message, tag 1. ListDevices is read-only;
+        // an empty list is valid while the target is still in DFU.
+        let request = br#"<?xml version="1.0" encoding="UTF-8"?><plist version="1.0"><dict><key>MessageType</key><string>ListDevices</string><key>ClientVersionString</key><string>restorekit</string><key>ProgName</key><string>restorekit</string><key>kLibUSBMuxVersion</key><integer>3</integer></dict></plist>"#;
+        let mut packet = Vec::with_capacity(16 + request.len());
+        for word in [(16 + request.len()) as u32, 1, 8, 1] {
+            packet.extend_from_slice(&word.to_le_bytes());
+        }
+        packet.extend_from_slice(request);
+        stream.write_all(&packet).map_err(|e| e.to_string())?;
+        let mut header = [0u8; 16];
+        stream.read_exact(&mut header).map_err(|e| e.to_string())?;
+        let word = |offset| u32::from_le_bytes(header[offset..offset + 4].try_into().unwrap());
+        let size = word(0) as usize;
+        if !(16..=1_048_576).contains(&size) || word(4) != 1 || word(8) != 8 || word(12) != 1 {
+            return Err("invalid usbmux ListDevices response header".into());
+        }
+        let mut payload = vec![0; size - 16];
+        stream.read_exact(&mut payload).map_err(|e| e.to_string())?;
+        let reply = plist::Value::from_reader(std::io::Cursor::new(payload))
+            .map_err(|e| format!("invalid usbmux response plist: {e}"))?;
+        if reply.as_dictionary().and_then(|d| d.get("DeviceList")).and_then(plist::Value::as_array).is_none() {
+            return Err("usbmux service did not return a DeviceList".into());
+        }
+        Ok(())
+    };
+    probe().and_then(|_| sys::probe_native_private_mux()).map_err(|message| Error::UsbmuxdFailed(format!(
+        "private Windows usbmux protocol probe failed: {message}"
+    )))
+}
