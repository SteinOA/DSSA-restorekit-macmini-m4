+struct restore_serial_context {
+	struct mode_context *mode;
+	uint8_t index;
+	uint16_t language;
+	int serial_phase;
+};
+
+static void restore_serial_log(struct libusb_transfer *transfer,
+	struct restore_serial_context *check, const char *reason, const char *serial)
+{
+	char hex[255*2+1];
+	unsigned char *data = libusb_control_transfer_get_data(transfer);
+	int count = transfer->actual_length;
+	if (count < 0) count = 0;
+	if (count > 255) count = 255;
+	for (int i = 0; i < count; i++) snprintf(hex+i*2, 3, "%02X", data[i]);
+	hex[count*2] = '\0';
+	usbmuxd_log(LL_WARNING,
+		"PID1905 identity phase=%s reason=%s status=%d actual_length=%d langid=%04X raw=%s decoded_serial=%s",
+		check->serial_phase ? "serial" : "languages", reason,
+		transfer->status, transfer->actual_length, check->language, hex, serial);
+}
+
+/* Validate the one authorized final restore target asynchronously before any
+ * mode switch, configuration, or interface claim. Hotplug forbids blocking I/O. */
+static void LIBUSB_CALL verify_restore_serial_cb(struct libusb_transfer *transfer)
+{
+	struct restore_serial_context *check = transfer->user_data;
+	struct mode_context *mode = check->mode;
+	struct usb_device *usbdev = find_device(mode->bus, mode->address);
+	const unsigned char *data = libusb_control_transfer_get_data(transfer);
+	char serial[128] = "";
+	const char *error = NULL;
+	if (!usbdev || !usbdev->alive || usbdev->handle != transfer->dev_handle) error = "device-gone-or-dead";
+	else if (transfer->status != LIBUSB_TRANSFER_COMPLETED) error = "usb-transfer-not-completed";
+	else if (transfer->actual_length < 0 || transfer->actual_length > 255) error = "invalid-transfer-length";
+	else if (!check->serial_phase) {
+		error = rk_advertised_language(data, (size_t)transfer->actual_length, &check->language);
+		if (!error) {
+			restore_serial_log(transfer, check, "advertised-language-selected", serial);
+			check->serial_phase = 1;
+			memset(transfer->buffer, 0, LIBUSB_CONTROL_SETUP_SIZE + 255);
+			libusb_fill_control_setup(transfer->buffer, LIBUSB_ENDPOINT_IN, LIBUSB_REQUEST_GET_DESCRIPTOR,
+				(LIBUSB_DT_STRING << 8) | check->index, check->language, 255);
+			transfer->actual_length = 0;
+			int result = libusb_submit_transfer(transfer);
+			if (result == 0) return; /* Same transfer remains tracked across both IN reads. */
+			error = "serial-request-submit-failed";
+		}
+	} else {
+		error = rk_verify_restore_response(1, data, (size_t)transfer->actual_length, serial, sizeof(serial));
+	}
+	/* The final callback must drain before disconnect can release this handle. */
+	if (usbdev) collection_remove(&usbdev->rx_xfers, transfer);
+	if (error) {
+		restore_serial_log(transfer, check, error, serial);
+		if (usbdev) usbdev->alive = 0;
+	} else {
+		restore_serial_log(transfer, check, "authorized-identity-verified", serial);
+		strcpy(usbdev->serial, "00008132-001808291EA2401C");
+		/* PID1905 already exposes restore mux. Preserve its current mode;
+		 * generic GET_MODE/SET_MODE heuristics target ordinary mobile devices. */
+		device_complete_initialization(mode, transfer->dev_handle);
+	}
+	free(check->mode);
+	free(check);
+	free(transfer->buffer);
+	libusb_free_transfer(transfer);
+}
+
+static int verify_restore_serial(struct libusb_device_handle *handle, uint8_t index, struct mode_context *context)
+{
+	if (!index) return -1;
+	struct usb_device *usbdev = find_device(context->bus, context->address);
+	if (!usbdev || !usbdev->alive || usbdev->handle != handle) return -1;
+	struct libusb_transfer *transfer = libusb_alloc_transfer(0);
+	unsigned char *buffer = calloc(1, LIBUSB_CONTROL_SETUP_SIZE + 255);
+	struct restore_serial_context *check = calloc(1, sizeof(*check));
+	if (!transfer || !buffer || !check) { free(buffer); free(check); if (transfer) libusb_free_transfer(transfer); return -1; }
+	check->mode = context;
+	check->index = index;
+	libusb_fill_control_setup(buffer, LIBUSB_ENDPOINT_IN, LIBUSB_REQUEST_GET_DESCRIPTOR,
+		LIBUSB_DT_STRING << 8, 0, 255);
+	libusb_fill_control_transfer(transfer, handle, buffer, verify_restore_serial_cb, check, 1000);
+	/* Register before submission, so unplug cancellation cannot miss this request. */
+	collection_add(&usbdev->rx_xfers, transfer);
+	int result = libusb_submit_transfer(transfer);
+	if (result != 0) {
+		collection_remove(&usbdev->rx_xfers, transfer);
+		restore_serial_log(transfer, check, "language-request-submit-failed", "");
+		free(check); /* Caller retains context on initial submission failure. */
+		free(buffer);
+		libusb_free_transfer(transfer);
+	}
+	return result;
+}
